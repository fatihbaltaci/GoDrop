// godrop.sh: the landing page, the install script and the reachability probe.
//
// Deployed by Cloudflare Workers Builds on every push to main. The build
// command copies install.sh into the asset directory so that
// https://godrop.sh/install.sh serves the same file the repository holds:
//
//   Build command:   cp install.sh site/install.sh
//   Deploy command:  npx wrangler deploy
//
// Nothing here affects the GoDrop binary. It is the project's website.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godrop",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },

  // The site answers on godrop.sh and nowhere else. Attaching the domain here
  // rather than in the dashboard means a deploy from a clean checkout ends up
  // serving the same thing.
  //
  // workers.dev and preview URLs stay off deliberately: /api/check is
  // unauthenticated and the rate limiting rule that protects it is a WAF rule
  // on this zone, which those hostnames would go around.
  "routes": [
    {
      "pattern": "godrop.sh",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }
}
