# GoDrop configuration. Copy to .env and edit; every value is optional except
# the token list.
#
#   cp .env.example .env
#   godrop token create --name default      # or set GODROP_TOKENS below

# ── Required ────────────────────────────────────────────────────────────────

# API tokens for uploads and deletes, comma separated. Downloads never need one.
# Tokens created with `godrop token create` live in the data directory instead
# and work alongside these.
GODROP_TOKENS=

# ── Addressing ──────────────────────────────────────────────────────────────

# Public URL of this instance. Leave empty to derive it from each request, which
# is fine locally but wrong behind a reverse proxy.
GODROP_BASE_URL=

# Listen address.
GODROP_ADDR=:8080

# Where uploaded files are stored. Inside a container this is /data.
GODROP_DATA_DIR=./data

# ── Limits ──────────────────────────────────────────────────────────────────

# Rejected with 413 above this. Your reverse proxy must allow at least as much
# (nginx: client_max_body_size, Caddy: request_body max_size).
GODROP_MAX_FILE_SIZE=100MB

# Files accepted in a single multipart request.
GODROP_MAX_FILES_PER_REQUEST=20

# Uploads stop with 507 once this much is stored. Empty means unlimited, and a
# full disk takes the whole server down with it.
GODROP_MAX_TOTAL_SIZE=

# Delete files this long after upload, e.g. 30d. Empty keeps them forever.
GODROP_RETENTION=

# Uploads per token, e.g. 60/m. Empty disables the limit.
GODROP_RATE_LIMIT=

# Failed authentications per client address, e.g. 10/m. Slows down token
# guessing. Empty disables the limit.
GODROP_AUTH_RATE_LIMIT=

# ── HTTP ────────────────────────────────────────────────────────────────────

# Guards against slow-header attacks. The body timeouts stay at 0 on purpose:
# a large file over a slow connection is legitimate, and the size limit above is
# what bounds an upload.
GODROP_READ_HEADER_TIMEOUT=10s
GODROP_READ_TIMEOUT=0
GODROP_WRITE_TIMEOUT=0
GODROP_IDLE_TIMEOUT=120s
GODROP_SHUTDOWN_TIMEOUT=30s

# Browser origins allowed to call the API. * is the default; narrow it if only
# your own front end uses GoDrop.
GODROP_CORS_ORIGINS=*

# ── Operations ──────────────────────────────────────────────────────────────

GODROP_LOG_FORMAT=json    # json or text
GODROP_LOG_LEVEL=info     # debug, info, warn, error
GODROP_ACCESS_LOG=true    # per-request log lines, including client addresses

# Anonymous daily heartbeat: install id, version, os, arch and deployment type.
# Nothing about your files, your users or your addresses. Set to off to disable,
# or run `godrop telemetry off`.
GODROP_TELEMETRY=on
